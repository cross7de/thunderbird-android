<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mail_list_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="32dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:background="#fff"
    >

    <!-- A regular View breaks things for some reason, but a TextView does the job -->
    <TextView
        android:id="@+id/chip"
        android:layout_width="3dp"
        android:layout_height="match_parent"
        tools:background="#0099CC"
        />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="2dp"
        android:paddingBottom="2dp"
        >

        <TextView
            android:id="@+id/sender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="13sp"
            tools:text="Absender mit langem Namen"
            />

        <TextView
            android:id="@+id/mail_subject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textSize="12sp"
            tools:text="Ein längerer Betreff"
            />

    </LinearLayout>

    <TextView
        android:id="@+id/mail_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:includeFontPadding="false"
        android:maxLines="2"
        android:minLines="2"
        android:paddingStart="2dp"
        android:paddingTop="2dp"
        android:paddingEnd="3dp"
        android:textSize="10sp"
        tools:text="30.10.\n04:54"
        />

    <ImageButton
        android:id="@+id/delete_item"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="?android:attr/selectableItemBackground"
        android:contentDescription="@string/message_list_widget_delete_message_action"
        android:padding="7dp"
        android:scaleType="fitCenter"
        android:src="@android:drawable/ic_menu_delete"
        android:visibility="gone"
        />

</LinearLayout>
