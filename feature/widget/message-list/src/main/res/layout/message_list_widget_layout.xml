<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    >

    <LinearLayout
        android:id="@+id/top_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/message_list_widget_header_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        >

        <!-- All visible actions share the available width, including at 2x1. -->
        <ImageButton
            android:id="@+id/open_inbox"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_inbox_title"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_dialog_email"
            android:visibility="gone"
            />

        <ImageButton
            android:id="@+id/sync_mail"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_sync_action"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_popup_sync"
            />

        <ImageButton
            android:id="@+id/new_message"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_compose_action"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_edit"
            />

        <ImageButton
            android:id="@+id/widget_settings"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_settings_action"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_preferences"
            />

        <ImageButton
            android:id="@+id/toggle_delete"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_delete_mode_action"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_delete"
            />

        <!-- The active delete-mode icon remains visible even if the message list is empty. -->
        <ImageButton
            android:id="@+id/toggle_delete_active"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:contentDescription="@string/message_list_widget_delete_mode_action"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_delete"
            android:tint="@android:color/holo_red_light"
            android:visibility="gone"
            />

    </LinearLayout>

    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="?android:attr/colorBackground"
        android:divider="@color/message_list_widget_divider"
        android:dividerHeight="0.5dp"
        />

</LinearLayout>
