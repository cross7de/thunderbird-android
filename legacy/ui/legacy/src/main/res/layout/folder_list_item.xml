<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/folder_list_item_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    >

    <ImageView
        android:id="@+id/folder_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        tools:srcCompat="@drawable/ic_inbox"
        />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/folder_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        tools:text="Inbox"
        />

    <!-- Explicit destination action; tapping a parent row only opens or closes its subtree. -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/folder_choose_destination"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:minWidth="72dp"
        android:gravity="center"
        android:insetTop="6dp"
        android:insetBottom="6dp"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/choose_folder_select_here"
        android:textAllCaps="false"
        android:textColor="?attr/colorPrimary"
        app:cornerRadius="18dp"
        android:visibility="gone"
        />

    <ImageButton
        android:id="@+id/folder_expand"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/choose_folder_expand"
        android:src="@android:drawable/arrow_down_float"
        android:visibility="gone"
        />

</LinearLayout>
